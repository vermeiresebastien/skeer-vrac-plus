{
  "name": "vrac-plus-web",
  "private": true,
  "version": "1.0.0",
  "description": "VRAC+ — a sample-based drum machine in the browser. Drop any sound, auto-slice it, and morph each pad across kick, snare, hat and clap models.",
  "type": "module",
  "scripts": {
    "worklet": "node scripts/build-worklet.mjs",
    "dev": "node scripts/build-worklet.mjs && vite",
    "build": "node scripts/build-worklet.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/e2e.mjs",
    "test:screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
